#!/bin/bash
set -euo pipefail

SESSION_NAME="claude-nethack"
SESSION_WIDTH=154
SESSION_HEIGHT=60
KEY_DELAY=0.3
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SHOW_NEIGHBORHOOD=false
BATCH_MODE=false

usage() {
    cat <<'EOF'
NetHack tmux interface for terminal-capable agents

USAGE:
    ./run                       Observe an existing game (no input sent)
    ./run ACTION                Send one action, then observe
    ./run --batch ACTION...     Explicitly send a sequence, capturing each action
    ./run --init                Restart the tmux session and launch NetHack
    ./run --cleanup             Kill the tmux session
    ./run --help                Show this help

Add --neighborhood before an action or session option to append the optional
5x5 neighborhood and adjacent-cell labels when the player can be verified.
The default output contains only the original screen.

EXAMPLES:
    ./run h                     Move west
    ./run o                     Start opening a door; inspect the direction prompt
    ./run h                     Answer that prompt with west
    ./run Space                 Dismiss a pager
    ./run Escape                Cancel a command
    ./run '>'                   Descend stairs
    ./run '#quit'               Extended command (Enter appended automatically)
    ./run '^P'                  Message history (C-p also works)
    ./run --batch o h           Open west, only when the input sequence is known
    ./run --neighborhood        Observe with the optional neighborhood
    ./run --neighborhood h      Move west and show the neighborhood
    ./run --neighborhood --batch o h

An ACTION can also be literal text or a repeat such as 5k. Such strings send
multiple keystrokes without intermediate observation; prefer single keys.
Batch mode labels and captures each argument, but does not decide whether to continue
when a prompt appears. Avoid batches during exploration or combat.
Initialization may restore a saved game; it does not delete NetHack saves.
See README.md and AGENTS.md for setup and gameplay instructions.
EOF
}

send_input() {
    local key="$1" literal
    # Control bytes need send-keys: paste-buffer can turn them into printable
    # caret notation. Some tmux versions reject send-keys with a read-only
    # viewer attached; propagate that failure instead of reporting success.
    if [ "$key" = "Escape" ]; then
        tmux send-keys -t "$SESSION_NAME" Escape
        return
    fi
    if [[ "$key" =~ ^(C-|\^)([A-Za-z])$ ]]; then
        tmux send-keys -t "$SESSION_NAME" "C-${BASH_REMATCH[2],,}"
        return
    fi
    case "$key" in
        Space)        literal=' ' ;;
        Enter|Return) literal=$'\r' ;;
        Tab)          literal=$'\t' ;;
        *)            literal="$key" ;;
    esac
    tmux set-buffer -b claude-run-input -- "$literal"
    tmux paste-buffer -d -b claude-run-input -t "$SESSION_NAME"
}

check_exit() {
    local state dead status signal screen
    state=$(tmux display-message -p -t "$SESSION_NAME" '#{pane_dead}:#{pane_dead_status}:#{pane_dead_signal}')
    IFS=: read -r dead status signal <<< "$state"
    if [ "$dead" = 1 ]; then
        screen=$(tmux capture-pane -p -t "$SESSION_NAME")
        printf '%s\n' "$screen" | uv run --script "$SCRIPT_DIR/transpose_map.py"
        if [ "$status" = 0 ] && [ -z "$signal" ]; then
            printf '%s\n' '--- Game exited normally ---'
            exit 0
        fi
        printf 'Game exited abnormally (status: %s; signal: %s).\n' \
            "${status:-unknown}" "${signal:-none}" >&2
        exit 1
    fi
}

observe() {
    local screen cursor_x cursor_y cursor
    local -a formatter_args=()
    check_exit
    # Capture before formatting so a failed capture cannot masquerade as an
    # empty successful observation. Only the optional helper needs a cursor.
    screen=$(tmux capture-pane -p -t "$SESSION_NAME")
    if [ "$SHOW_NEIGHBORHOOD" = true ]; then
        cursor=$(tmux display-message -p -t "$SESSION_NAME" '#{cursor_x} #{cursor_y}')
        read -r cursor_x cursor_y <<< "$cursor"
        formatter_args=(--cursor "$cursor_x" "$cursor_y")
    fi
    printf '%s\n' "$screen" | uv run --script "$SCRIPT_DIR/transpose_map.py" "${formatter_args[@]}"
}

if [ "${1:-}" = "--neighborhood" ]; then
    SHOW_NEIGHBORHOOD=true
    shift
fi

case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    --init|--cleanup)
        if [ "$#" -ne 1 ]; then
            echo "$1 does not accept action arguments." >&2
            exit 2
        fi
        if [ "$1" = "--cleanup" ]; then
            tmux kill-session -t "$SESSION_NAME"
            exit 0
        fi
        if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
            tmux kill-session -t "$SESSION_NAME"
        fi
        tmux new-session -d -s "$SESSION_NAME" -x "$SESSION_WIDTH" -y "$SESSION_HEIGHT" \
            -e 'NETHACKOPTIONS=whatis_coord:m,windowtype:tty' -- \
            nethack -u Claude -p valkyrie -r human
        tmux set-option -t "$SESSION_NAME" window-size manual
        tmux set-option -p -t "$SESSION_NAME" remain-on-exit on
        sleep 1
        # Do not automatically dismiss a startup or restored-game prompt.
        observe
        exit 0
        ;;
    --batch)
        BATCH_MODE=true
        shift
        if [ "$#" -eq 0 ]; then
            echo '--batch requires at least one action.' >&2
            exit 2
        fi
        ;;
    --*) echo "Unknown option: $1" >&2; exit 2 ;;
    *)
        if [ "$#" -gt 1 ]; then
            echo 'Send one action and inspect the result, or explicitly use --batch.' >&2
            exit 2
        fi
        ;;
esac

if [ "$#" -eq 0 ]; then
    observe
    exit 0
fi

# Retain exit status even for games started by older versions of this tool.
tmux set-option -p -t "$SESSION_NAME" remain-on-exit on
check_exit
action_index=0
for arg in "$@"; do
    action_index=$((action_index + 1))
    if [ "$BATCH_MODE" = true ]; then
        printf -- '--- Action %d/%d: %s ---\n' "$action_index" "$#" "${arg@Q}"
    fi
    send_input "$arg"
    sleep "$KEY_DELAY"
    if [[ "$arg" == '#'* ]]; then
        send_input Enter
        sleep "$KEY_DELAY"
    fi
    observe
done
