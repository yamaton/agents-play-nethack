#!/bin/bash
set -euo pipefail

SESSION_NAME="claude-nethack"
SESSION_WIDTH=154
SESSION_HEIGHT=60
KEY_DELAY=0.3
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
    cat <<'EOF'
NetHack tmux Interface - Claude Code NetHack Project

USAGE:
    ./run                       Observe an existing game (no input sent)
    ./run ACTION                Send one action, then observe
    ./run --batch ACTION...     Explicitly send a sequence, capturing each action
    ./run --init                Restart the tmux session and launch NetHack
    ./run --cleanup             Kill the tmux session
    ./run --help                Show this help

EXAMPLES:
    ./run h                     Move west
    ./run o                     Start opening a door; inspect the direction prompt
    ./run h                     Answer that prompt with west
    ./run Space                 Dismiss a pager
    ./run Escape                Cancel a command
    ./run '>'                   Descend stairs
    ./run '#quit'               Extended command (Enter appended automatically)
    ./run '^P'                  Message history (C-p also works)
    ./run --batch o h           Open west, only when the input sequence is known

An ACTION can also be literal text or a repeat such as 5k. Such strings send
multiple keystrokes without intermediate observation; prefer single keys.
Batch mode captures each argument, but does not decide whether to continue
when a prompt appears. Avoid batches during exploration or combat.
Initialization may restore a saved game; it does not delete NetHack saves.
See README.md and CLAUDE.md for instructions.
EOF
}

send_input() {
    local key="$1" literal
    # Control bytes need send-keys: paste-buffer can turn them into printable
    # caret notation. Some tmux versions reject send-keys with a read-only
    # viewer attached; propagate that failure instead of reporting success.
    if [ "$key" = "Escape" ]; then
        tmux send-keys -t "$SESSION_NAME" Escape
        return
    fi
    if [[ "$key" =~ ^(C-|\^)([A-Za-z])$ ]]; then
        tmux send-keys -t "$SESSION_NAME" "C-${BASH_REMATCH[2],,}"
        return
    fi
    case "$key" in
        Space)        literal=' ' ;;
        Enter|Return) literal=$'\r' ;;
        Tab)          literal=$'\t' ;;
        *)            literal="$key" ;;
    esac
    tmux set-buffer -b claude-run-input -- "$literal"
    tmux paste-buffer -d -b claude-run-input -t "$SESSION_NAME"
}

observe() {
    local screen cursor_x cursor_y cursor
    # Capture before formatting so a failed capture cannot masquerade as an
    # empty successful observation. Cursor metadata must also succeed.
    screen=$(tmux capture-pane -p -t "$SESSION_NAME")
    cursor=$(tmux display-message -p -t "$SESSION_NAME" '#{cursor_x} #{cursor_y}')
    read -r cursor_x cursor_y <<< "$cursor"
    printf '%s\n' "$screen" | python3 "$SCRIPT_DIR/transpose_map.py" --cursor "$cursor_x" "$cursor_y"
}

case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    --init|--cleanup)
        if [ "$#" -ne 1 ]; then
            echo "$1 does not accept action arguments." >&2
            exit 2
        fi
        if [ "$1" = "--cleanup" ]; then
            tmux kill-session -t "$SESSION_NAME"
            exit 0
        fi
        if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
            tmux kill-session -t "$SESSION_NAME"
        fi
        tmux new-session -d -s "$SESSION_NAME" -x "$SESSION_WIDTH" -y "$SESSION_HEIGHT" \
            -e 'NETHACKOPTIONS=whatis_coord:m,windowtype:tty' -- \
            nethack -u Claude -p valkyrie -r human
        tmux set-option -t "$SESSION_NAME" window-size manual
        sleep 1
        # Do not automatically dismiss a startup or restored-game prompt.
        observe
        exit 0
        ;;
    --batch)
        shift
        if [ "$#" -eq 0 ]; then
            echo '--batch requires at least one action.' >&2
            exit 2
        fi
        ;;
    --*) echo "Unknown option: $1" >&2; exit 2 ;;
    *)
        if [ "$#" -gt 1 ]; then
            echo 'Send one action and inspect the result, or explicitly use --batch.' >&2
            exit 2
        fi
        ;;
esac

if [ "$#" -eq 0 ]; then
    observe
    exit 0
fi

for arg in "$@"; do
    send_input "$arg"
    sleep "$KEY_DELAY"
    if [[ "$arg" == '#'* ]]; then
        send_input Enter
        sleep "$KEY_DELAY"
    fi
    observe
done
